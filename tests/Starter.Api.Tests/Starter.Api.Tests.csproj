<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration tests: the real Starter.Identity and Starter.Api run in-process against SQL Server
       (Testcontainers), and tokens are obtained through the real Authorization Code + PKCE flow. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Test method names describe behaviour with underscores. -->
    <NoWarn>$(NoWarn);CA1707;CA1001;CA2234;CA1816</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Starter.Api\Starter.Api.csproj" />
    <ProjectReference Include="..\..\src\Starter.Identity\Starter.Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
