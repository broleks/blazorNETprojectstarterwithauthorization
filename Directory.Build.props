<Project>
  <!-- Settings shared by every project in the starter. Keep this file small: project-specific
       settings belong in the project file so that each project stays understandable on its own. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1515 (make types internal) and CA1848 (LoggerMessage delegates) add noise without
         much value for application code in a starter; the rest of the recommended rules stay on. -->
    <NoWarn>$(NoWarn);CA1515;CA1848;CA1873;CA2007;CA1062;CA1716;CA1056;CA1054;CA1055;CA1002;CA2227;CA1031;CA1724;CA1819;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304</NoWarn>
    <!-- Lock files make restores reproducible in CI and container builds. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
