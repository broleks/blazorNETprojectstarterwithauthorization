# Build output
bin/
obj/
publish/
*.user
*.suo
.vs/
.vscode/*
!.vscode/extensions.json
.idea/

# Local secrets and certificates - never commit these (see docs/configuration.md)
.env
.certs/
*.pfx
*.p12
*.key
*.pem
