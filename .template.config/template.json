{
  "$schema": "http://json.schemastore.org/template",
  "author": "Starter maintainers",
  "classifications": ["Web", "Blazor", "OpenID Connect", "Solution"],
  "identity": "Starter.BlazorOpenIddict.Solution",
  "name": "Blazor Server + OpenIddict starter",
  "description": "Blazor Web App (Interactive Server), ASP.NET Core Identity + OpenIddict, protected Web API, SQL Server, Docker Compose, integration and Playwright tests.",
  "shortName": "blazor-oidc-starter",
  "sourceName": "Starter",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".vs/**",
            ".env",
            ".certs/**",
            "**/bin/**",
            "**/obj/**",
            "**/TestResults/**",
            ".template.config/**"
          ]
        }
      ]
    }
  ],
  "symbols": {
    "identitySecretsSuffix": {
      "type": "generated",
      "generator": "random",
      "parameters": { "low": 10000000, "high": 99999999 },
      "replaces": "3b7e9a41"
    },
    "apiSecretsSuffix": {
      "type": "generated",
      "generator": "random",
      "parameters": { "low": 10000000, "high": 99999999 },
      "replaces": "8f1c2d0e"
    },
    "webSecretsSuffix": {
      "type": "generated",
      "generator": "random",
      "parameters": { "low": 10000000, "high": 99999999 },
      "replaces": "c5d2a7f3"
    }
  }
}
