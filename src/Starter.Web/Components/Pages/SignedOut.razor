@page "/signed-out"
@attribute [AllowAnonymous]
@layout EmptyLayout

<PageTitle>Signed out · Starter</PageTitle>

<section class="card auth-card" aria-labelledby="page-title">
    <h1 id="page-title">You have signed out</h1>
    <p role="status">Your session has ended on this device.</p>
    <a class="btn btn-primary btn-block" href="authentication/login">Sign in again</a>
</section>
