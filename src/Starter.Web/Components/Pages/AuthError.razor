@page "/authentication/error"
@attribute [AllowAnonymous]
@layout EmptyLayout

<PageTitle>Sign-in problem · Starter</PageTitle>

<section class="card auth-card" aria-labelledby="page-title">
    <h1 id="page-title">We could not sign you in</h1>
    <p role="alert">The sign-in took too long or was interrupted. Please try again.</p>
    <a class="btn btn-primary btn-block" href="authentication/login">Try again</a>
</section>
