<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/Starter.Ui/theme.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["Starter.Web.styles.css"]" />
    @* No <ImportMap />: it renders an inline script, which the Content-Security-Policy (script-src 'self') blocks.
       JavaScript modules are imported by their path instead. *@
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>

<body>
    <Routes @rendermode="RenderModeForPage" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // The whole UI is interactive (Blazor Server). Prerendering is off so every page loads its data once,
    // inside the circuit, through the same token-handling path (see docs/architecture.md).
    private static readonly IComponentRenderMode RenderModeForPage = new InteractiveServerRenderMode(prerender: false);
}
