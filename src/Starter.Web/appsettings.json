{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "",
    "ClientId": "starter-web",
    "ClientSecret": ""
  },
  "Api": {
    "BaseUrl": ""
  },
  "ActivityLogging": {
    "Enabled": true,
    "Destination": "File",
    "RetentionDays": 7,
    "Categories": {
      "Errors": true,
      "Security": true,
      "Api": true,
      "Frontend": false
    },
    "File": {
      "Path": "logs"
    },
    "Elasticsearch": {
      "Url": "",
      "ApiKey": "",
      "Namespace": "production"
    }
  }
}
