{
  "Database": {
    "MigrateOnStartup": true
  },
  "Authentication": {
    "Issuer": "https://localhost:7001/",
    "DefaultReturnUrl": "https://localhost:7003/"
  },
  "OpenIddict": {
    "Clients": {
      "starter-web": {
        "RedirectUris": [ "https://localhost:7003/signin-oidc" ],
        "PostLogoutRedirectUris": [ "https://localhost:7003/signout-callback-oidc" ]
      }
    }
  },
  "RateLimiting": {
    "AccountPostsPerMinute": 200
  },
  "Email": {
    "FromAddress": "no-reply@starter.local",
    "Host": "localhost",
    "Port": 1025,
    "Security": "None"
  }
}
