@page
@model Starter.Identity.Pages.Account.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password reset";
}
<section class="card auth-card" aria-labelledby="page-title">
    <h1 id="page-title">Your password has been reset</h1>
    <p role="status">You have been signed out on all devices. Sign in with your new password.</p>
    <a class="btn btn-primary btn-block" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
</section>
