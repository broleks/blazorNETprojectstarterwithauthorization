@page
@model Starter.Identity.Pages.Account.RegisterConfirmationModel
@{
    ViewData["Title"] = "Check your email";
}
<section class="card auth-card" aria-labelledby="page-title">
    <h1 id="page-title">Check your email</h1>
    <p>We sent a confirmation link to the email address you entered. Open it to activate your account.</p>
    <p class="muted">Didn't get the email? Check your spam folder or <a asp-page="./ResendEmailConfirmation" asp-route-returnUrl="@Model.ReturnUrl">send it again</a>.</p>
</section>
