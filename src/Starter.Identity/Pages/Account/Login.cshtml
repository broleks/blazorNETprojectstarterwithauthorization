@page
@model Starter.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<section class="card auth-card" aria-labelledby="page-title">
    <h1 id="page-title">Sign in</h1>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-error" role="alert" data-testid="login-error">
            <p>@Model.ErrorMessage</p>
            @if (Model.ShowResendConfirmation)
            {
                <p><a asp-page="./ResendEmailConfirmation" asp-route-returnUrl="@Model.ReturnUrl">Send the confirmation email again</a></p>
            }
        </div>
    }

    <form method="post" novalidate class="stack">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" type="email" autocomplete="username" required />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" autocomplete="current-password" required />
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Sign in</button>
    </form>

    <p class="form-links"><a asp-page="./ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl">Forgot your password?</a></p>

    @if (Model.ExternalLogins.Count > 0)
    {
        <div class="divider"><span>or</span></div>
        <form asp-page="./ExternalLogin" method="post" class="stack">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            @foreach (var provider in Model.ExternalLogins)
            {
                <button type="submit" class="btn btn-secondary btn-block" name="provider" value="@provider.Name">
                    Continue with @provider.DisplayName
                </button>
            }
        </form>
    }

    <p class="card-footer-text">New here? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></p>
</section>
