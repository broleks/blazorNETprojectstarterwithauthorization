@page
@model Starter.Identity.Pages.Account.Manage.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}
<section class="card manage-card" aria-labelledby="page-title">
    <h1 id="page-title">Your account</h1>
    <partial name="_ManageNav" model="Model" />
    <partial name="_Alerts" model="((string?)null, Model.StatusMessage)" />

    <h2>Change password</h2>
    <form method="post" novalidate class="stack">
        <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="field">
            <label asp-for="Input.OldPassword"></label>
            <input asp-for="Input.OldPassword" autocomplete="current-password" required />
            <span asp-validation-for="Input.OldPassword" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.NewPassword"></label>
            <input asp-for="Input.NewPassword" autocomplete="new-password" required />
            <span asp-validation-for="Input.NewPassword" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" required />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary">Change password</button>
    </form>
</section>
