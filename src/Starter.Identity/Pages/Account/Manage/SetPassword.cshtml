@page
@model Starter.Identity.Pages.Account.Manage.SetPasswordModel
@{
    ViewData["Title"] = "Set a password";
}
<section class="card manage-card" aria-labelledby="page-title">
    <h1 id="page-title">Your account</h1>
    <partial name="_ManageNav" model="Model" />
    <h2>Set a password</h2>
    <p>Your account does not have a password yet. Add one to be able to sign in with your email address too.</p>
    <form method="post" novalidate class="stack">
        <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="field">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" autocomplete="new-password" required />
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" required />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary">Set password</button>
    </form>
</section>
