@page
@model Starter.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Check your email";
}
<section class="card auth-card" aria-labelledby="page-title">
    <h1 id="page-title">Check your email</h1>
    <p role="status">If an account uses this address, we have sent a link to reset the password. The link expires in a few hours.</p>
    <p><a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Back to sign in</a></p>
</section>
