@page
@model Starter.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}
<section class="card auth-card" aria-labelledby="page-title">
    <h1 id="page-title">Choose a new password</h1>
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-error" role="alert">
            <p>@Model.ErrorMessage</p>
            <p><a asp-page="./ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl">Request a new link</a></p>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.Input.Code))
    {
        <form method="post" novalidate class="stack">
            <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>
            <input type="hidden" asp-for="Input.Code" />
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" autocomplete="username" required />
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" autocomplete="new-password" required />
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" required />
                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Reset password</button>
        </form>
    }
</section>
