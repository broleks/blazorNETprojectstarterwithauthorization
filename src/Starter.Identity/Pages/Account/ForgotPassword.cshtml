@page
@model Starter.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}
<section class="card auth-card" aria-labelledby="page-title">
    <h1 id="page-title">Forgot your password?</h1>
    <p>Enter your email address and we will send you a link to choose a new password.</p>
    <form method="post" novalidate class="stack">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="field">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" autocomplete="email" required />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Send reset link</button>
    </form>
    <p class="card-footer-text"><a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Back to sign in</a></p>
</section>
