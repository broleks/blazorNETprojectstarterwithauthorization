@page
@model Starter.Identity.Pages.ErrorModel
@{
    ViewData["Title"] = Model.Title;
}
<section class="card auth-card" aria-labelledby="page-title">
    <h1 id="page-title">@Model.Title</h1>
    <p>@Model.Message</p>
    @if (Model.RequestId is not null)
    {
        <p class="muted">Reference: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-secondary" href="/Account/Login">Go to sign in</a>
</section>
