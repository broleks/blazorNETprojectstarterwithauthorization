{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "OpenIddict": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Issuer": ""
  },
  "RateLimiting": {
    "RequestsPerMinute": 300,
    "WritesPerMinute": 60
  },
  "ActivityLogging": {
    "Enabled": true,
    "Destination": "File",
    "RetentionDays": 7,
    "Categories": {
      "Errors": true,
      "Security": true,
      "Api": true,
      "Frontend": false
    },
    "File": {
      "Path": "logs"
    },
    "Elasticsearch": {
      "Url": "",
      "ApiKey": "",
      "Namespace": "production"
    }
  }
}
